__pycache__/
*.pyc
.venv/

# No-redistribution policy for vendor firmware (see firmware/README.md
# and PLAN.md Stage 7) - never commit raw/extracted firmware images,
# only the decompiled pseudo-C snippets actually analyzed.
firmware/raw/*
!firmware/raw/.gitkeep
firmware/extracted/*
!firmware/extracted/.gitkeep
firmware/**/raw/
firmware/**/extracted/

# BusyBox source clone + build worktrees used to produce Tier B binaries
# (binaries/tier-b/) — reproducible from the commit hashes recorded in
# each PROVENANCE.md, not committed themselves.
dataset/
